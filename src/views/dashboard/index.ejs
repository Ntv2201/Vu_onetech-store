<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1">Bảng điều khiển Tổng quan</h4>
    <p class="text-muted small mb-0">Quản lý kho hàng, truy vết IMEI và theo dõi kinh doanh</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/may-imei/them-moi" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Nhập máy / IMEI
    </a>
    <a href="/san-pham/them-moi" class="btn btn-outline-primary btn-sm">
      <i class="bi bi-phone me-1"></i> Thêm Model SP
    </a>
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-custom card-stat">
      <div>
        <div class="text-muted small fw-semibold">TỔNG MÁY (THEO IMEI)</div>
        <div class="fs-3 fw-bold mt-1"><%= stats.totalMayImei %></div>
        <div class="small text-muted mt-1"><%= stats.totalSanPham %> Model sản phẩm</div>
      </div>
      <div class="stat-icon primary">
        <i class="bi bi-upc-scan"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-custom card-stat">
      <div>
        <div class="text-muted small fw-semibold">MÁY CÒN TRONG KHO</div>
        <div class="fs-3 fw-bold mt-1 text-success"><%= stats.imeiConHang %></div>
        <div class="small text-success mt-1">Sẵn sàng xuất bán</div>
      </div>
      <div class="stat-icon success">
        <i class="bi bi-box-seam"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-custom card-stat">
      <div>
        <div class="text-muted small fw-semibold">MÁY ĐÃ BÁN</div>
        <div class="fs-3 fw-bold mt-1 text-primary"><%= stats.imeiDaBan %></div>
        <div class="small text-muted mt-1">Đã xuất theo hóa đơn</div>
      </div>
      <div class="stat-icon purple">
        <i class="bi bi-receipt"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-custom card-stat">
      <div>
        <div class="text-muted small fw-semibold">ĐANG BẢO HÀNH</div>
        <div class="fs-3 fw-bold mt-1 text-warning"><%= stats.imeiBaoHanh %></div>
        <div class="small text-warning mt-1">Đang tiếp nhận xử lý</div>
      </div>
      <div class="stat-icon warning">
        <i class="bi bi-tools"></i>
      </div>
    </div>
  </div>
</div>

<!-- Secondary Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="card-custom p-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon info" style="width: 44px; height: 44px; font-size: 1.25rem;">
          <i class="bi bi-people"></i>
        </div>
        <div>
          <div class="text-muted small">Khách hàng</div>
          <div class="fw-bold fs-5"><%= stats.totalKhachHang %></div>
        </div>
      </div>
      <a href="/khach-hang" class="btn btn-sm btn-light"><i class="bi bi-arrow-right"></i></a>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="card-custom p-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon primary" style="width: 44px; height: 44px; font-size: 1.25rem;">
          <i class="bi bi-truck"></i>
        </div>
        <div>
          <div class="text-muted small">Nhà cung cấp</div>
          <div class="fw-bold fs-5"><%= stats.totalNhaCungCap %></div>
        </div>
      </div>
      <a href="/nha-cung-cap" class="btn btn-sm btn-light"><i class="bi bi-arrow-right"></i></a>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="card-custom p-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon success" style="width: 44px; height: 44px; font-size: 1.25rem;">
          <i class="bi bi-person-badge"></i>
        </div>
        <div>
          <div class="text-muted small">Nhân viên</div>
          <div class="fw-bold fs-5"><%= stats.totalNhanVien %></div>
        </div>
      </div>
      <% if (currentUser && currentUser.vaiTro === 'Quản lý') { %>
        <a href="/nhan-vien" class="btn btn-sm btn-light"><i class="bi bi-arrow-right"></i></a>
      <% } else { %>
        <span class="badge bg-light text-muted">Bảo mật</span>
      <% } %>
    </div>
  </div>
</div>

<!-- Main Tables Row -->
<div class="row g-4">
  <!-- Recent IMEIs -->
  <div class="col-12 col-lg-7">
    <div class="card-custom">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-upc-scan me-2 text-primary"></i>Máy IMEI Mới Nhập</h6>
        <a href="/may-imei" class="btn btn-sm btn-link text-decoration-none">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-custom table-hover">
          <thead>
            <tr>
              <th>Số IMEI</th>
              <th>Sản phẩm</th>
              <th>Giá nhập</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentMayImei && recentMayImei.length > 0) { %>
              <% recentMayImei.forEach(item => { %>
                <tr>
                  <td>
                    <span class="font-monospace fw-bold text-dark"><%= item.imei %></span>
                    <% if (item.mauSac || item.dungLuong) { %>
                      <div class="small text-muted"><%= item.mauSac %> <%= item.dungLuong %></div>
                    <% } %>
                  </td>
                  <td><%= item.sanPham ? item.sanPham.tenMay : 'N/A' %></td>
                  <td><%= item.giaNhap ? item.giaNhap.toLocaleString('vi-VN') + ' đ' : '0 đ' %></td>
                  <td>
                    <% if (item.trangThai === 'Con hang') { %>
                      <span class="badge badge-imei-conhang px-2 py-1">Còn hàng</span>
                    <% } else if (item.trangThai === 'Da ban') { %>
                      <span class="badge badge-imei-daban px-2 py-1">Đã bán</span>
                    <% } else if (item.trangThai === 'Bao hanh') { %>
                      <span class="badge badge-imei-baohanh px-2 py-1">Bảo hành</span>
                    <% } else { %>
                      <span class="badge badge-imei-loi px-2 py-1">Lỗi</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3">Chưa có bản ghi IMEI nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent SanPham -->
  <div class="col-12 col-lg-5">
    <div class="card-custom">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-phone me-2 text-primary"></i>Danh Mục Model SP</h6>
        <a href="/san-pham" class="btn btn-sm btn-link text-decoration-none">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-custom table-hover">
          <thead>
            <tr>
              <th>Tên máy</th>
              <th>Hãng</th>
              <th>Giá bán</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentSanPham && recentSanPham.length > 0) { %>
              <% recentSanPham.forEach(sp => { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= sp.tenMay %></div>
                    <div class="small text-muted">BH <%= sp.soThangBH || 12 %> tháng</div>
                  </td>
                  <td><span class="badge bg-light text-dark border"><%= sp.hang || 'Khác' %></span></td>
                  <td class="text-primary fw-bold"><%= sp.giaBan ? sp.giaBan.toLocaleString('vi-VN') + ' đ' : '0 đ' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" class="text-center text-muted py-3">Chưa có sản phẩm nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
