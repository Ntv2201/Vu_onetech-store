<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Quản lý Model Sản phẩm</h4>
    <p class="text-muted small mb-0">Quản lý danh sách model điện thoại, cấu hình giá bán và thời hạn bảo hành</p>
  </div>
  <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
    <a href="/san-pham/them-moi" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Thêm Sản phẩm
    </a>
  <% } %>
</div>

<!-- Filters Bar -->
<div class="card-custom p-3 mb-4">
  <form action="/san-pham" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-4">
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên máy..." value="<%= filters.search || '' %>">
      </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
      <select name="danhMucId" class="form-select">
        <option value="">-- Tất cả danh mục --</option>
        <% danhMucs.forEach(dm => { %>
          <option value="<%= dm._id %>" <%= filters.danhMucId == dm._id.toString() ? 'selected' : '' %>><%= dm.tenDanhMuc %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
      <select name="hang" class="form-select">
        <option value="">-- Tất cả hãng --</option>
        <% allHangs.forEach(h => { %>
          <option value="<%= h %>" <%= filters.hang == h ? 'selected' : '' %>><%= h %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
      <a href="/san-pham" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
    </div>
  </form>
</div>

<!-- Table of SanPham -->
<div class="card-custom">
  <div class="table-responsive">
    <table class="table table-custom table-hover">
      <thead>
        <tr>
          <th>Tên sản phẩm</th>
          <th>Danh mục</th>
          <th>Hãng</th>
          <th>Giá niêm yết</th>
          <th>Bảo hành</th>
          <th>Tồn kho (IMEI)</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (sanPhams && sanPhams.length > 0) { %>
          <% sanPhams.forEach(sp => { %>
            <tr>
              <td>
                <a href="/san-pham/<%= sp._id %>/chi-tiet" class="fw-bold text-decoration-none text-dark">
                  <%= sp.tenMay %>
                </a>
                <% if (sp.moTa) { %>
                  <div class="text-muted small text-truncate" style="max-width: 280px;"><%= sp.moTa %></div>
                <% } %>
              </td>
              <td><span class="badge bg-light text-secondary border"><%= sp.danhMuc ? sp.danhMuc.tenDanhMuc : 'Chưa phân loại' %></span></td>
              <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle"><%= sp.hang || 'N/A' %></span></td>
              <td class="fw-bold text-primary"><%= sp.giaBan ? sp.giaBan.toLocaleString('vi-VN') + ' đ' : '0 đ' %></td>
              <td><span class="badge bg-info-subtle text-info-emphasis"><%= sp.soThangBH || 12 %> tháng</span></td>
              <td>
                <a href="/may-imei?sanPhamId=<%= sp._id %>" class="text-decoration-none">
                  <span class="badge <%= sp.soLuongCon > 0 ? 'bg-success' : 'bg-danger' %>">
                    <%= sp.soLuongCon %> máy sẵn có
                  </span>
                  <span class="text-muted small ms-1">(Tổng: <%= sp.tongImei %>)</span>
                </a>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <a href="/may-imei/them-moi?sanPhamId=<%= sp._id %>" class="btn btn-outline-success" title="Nhập thêm IMEI cho máy này">
                    <i class="bi bi-plus-circle"></i>
                  </a>
                  <a href="/san-pham/<%= sp._id %>/chi-tiet" class="btn btn-outline-info" title="Xem chi tiết & danh sách IMEI">
                    <i class="bi bi-eye"></i>
                  </a>
                  <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
                    <a href="/san-pham/<%= sp._id %>/chinh-sua" class="btn btn-outline-primary" title="Chỉnh sửa">
                      <i class="bi bi-pencil"></i>
                    </a>
                  <% } %>
                  <% if (currentUser && currentUser.vaiTro === 'Quản lý') { %>
                    <form action="/san-pham/<%= sp._id %>/xoa" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                      <button type="submit" class="btn btn-outline-danger" title="Xóa">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào phù hợp</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
