<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1"><%= sanPham.tenMay %></h4>
    <div class="text-muted small">
      Hãng: <span class="fw-semibold text-dark"><%= sanPham.hang || 'N/A' %></span> | 
      Danh mục: <span class="fw-semibold text-dark"><%= sanPham.danhMuc ? sanPham.danhMuc.tenDanhMuc : 'N/A' %></span> | 
      Bảo hành: <span class="fw-semibold text-dark"><%= sanPham.soThangBH || 12 %> tháng</span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/may-imei/them-moi?sanPhamId=<%= sanPham._id %>" class="btn btn-success btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Nhập thêm IMEI cho máy này
    </a>
    <a href="/san-pham" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-12 col-md-4">
    <div class="card-custom p-4 text-center">
      <div class="text-muted small fw-semibold">GIÁ BÁN NIÊM YẾT</div>
      <div class="fs-3 fw-bold text-primary my-2"><%= sanPham.giaBan ? sanPham.giaBan.toLocaleString('vi-VN') + ' đ' : '0 đ' %></div>
      <div class="text-muted small"><%= sanPham.moTa || 'Chưa có ghi chú mô tả' %></div>
    </div>
  </div>

  <div class="col-12 col-md-8">
    <div class="card-custom">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-upc-scan me-2 text-primary"></i>Danh sách máy vật lý (Theo từng IMEI)</h6>
        <span class="badge bg-primary"><%= imeis ? imeis.length : 0 %> máy</span>
      </div>
      <div class="table-responsive">
        <table class="table table-custom table-hover">
          <thead>
            <tr>
              <th>Số IMEI</th>
              <th>Màu sắc / Dung lượng</th>
              <th>Giá nhập</th>
              <th>Trạng thái</th>
              <th>Ngày nhập</th>
              <th class="text-end">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (imeis && imeis.length > 0) { %>
              <% imeis.forEach(item => { %>
                <tr>
                  <td><span class="font-monospace fw-bold"><%= item.imei %></span></td>
                  <td><%= item.mauSac || '-' %> <%= item.dungLuong ? '(' + item.dungLuong + ')' : '' %></td>
                  <td><%= item.giaNhap ? item.giaNhap.toLocaleString('vi-VN') + ' đ' : '0 đ' %></td>
                  <td>
                    <% if (item.trangThai === 'Con hang') { %>
                      <span class="badge badge-imei-conhang px-2 py-1">Còn hàng</span>
                    <% } else if (item.trangThai === 'Da ban') { %>
                      <span class="badge badge-imei-daban px-2 py-1">Đã bán</span>
                    <% } else if (item.trangThai === 'Bao hanh') { %>
                      <span class="badge badge-imei-baohanh px-2 py-1">Bảo hành</span>
                    <% } else { %>
                      <span class="badge badge-imei-loi px-2 py-1">Lỗi</span>
                    <% } %>
                  </td>
                  <td><%= new Date(item.ngayNhap || item.createdAt).toLocaleDateString('vi-VN') %></td>
                  <td class="text-end">
                    <a href="/may-imei/<%= item.imei %>/chinh-sua" class="btn btn-sm btn-outline-primary" title="Sửa trạng thái">
                      <i class="bi bi-pencil"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">Chưa có máy IMEI nào thuộc sản phẩm này trong kho</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
