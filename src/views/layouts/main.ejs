<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'One Tech Store' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body>

<div class="app-wrapper">
  <!-- Sidebar -->
  <aside class="app-sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <i class="bi bi-phone-vibrate"></i>
      <span>ONE TECH STORE</span>
    </a>

    <div class="sidebar-nav">
      <div class="nav-category">Tổng quan</div>
      <a href="/dashboard" class="sidebar-link <%= currentPath === '/dashboard' || currentPath === '/' ? 'active' : '' %>">
        <i class="bi bi-grid-1x2"></i>
        <span>Dashboard</span>
      </a>

      <div class="nav-category">Quản lý Hàng hóa</div>
      <a href="/san-pham" class="sidebar-link <%= currentPath.startsWith('/san-pham') ? 'active' : '' %>">
        <i class="bi bi-phone"></i>
        <span>Sản phẩm</span>
      </a>
      <a href="/may-imei" class="sidebar-link <%= currentPath.startsWith('/may-imei') ? 'active' : '' %>">
        <i class="bi bi-upc-scan"></i>
        <span>Quản lý IMEI/Máy</span>
      </a>
      <a href="/danh-muc" class="sidebar-link <%= currentPath.startsWith('/danh-muc') ? 'active' : '' %>">
        <i class="bi bi-tags"></i>
        <span>Danh mục</span>
      </a>
      <a href="/phu-kien" class="sidebar-link <%= currentPath.startsWith('/phu-kien') ? 'active' : '' %>">
        <i class="bi bi-headphones"></i>
        <span>Phụ kiện</span>
      </a>

      <div class="nav-category">Đối tác & Khách hàng</div>
      <a href="/khach-hang" class="sidebar-link <%= currentPath.startsWith('/khach-hang') ? 'active' : '' %>">
        <i class="bi bi-people"></i>
        <span>Khách hàng</span>
      </a>
      <a href="/nha-cung-cap" class="sidebar-link <%= currentPath.startsWith('/nha-cung-cap') ? 'active' : '' %>">
        <i class="bi bi-truck"></i>
        <span>Nhà cung cấp</span>
      </a>

      <% if (currentUser && currentUser.vaiTro === 'Quản lý') { %>
        <div class="nav-category">Hệ thống</div>
        <a href="/nhan-vien" class="sidebar-link <%= currentPath.startsWith('/nhan-vien') ? 'active' : '' %>">
          <i class="bi bi-shield-lock"></i>
          <span>Nhân viên & Phân quyền</span>
        </a>
      <% } %>
    </div>

    <!-- User box -->
    <% if (currentUser) { %>
      <div class="sidebar-user">
        <div class="d-flex align-items-center gap-2 mb-2">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-weight: 600;">
            <%= currentUser.hoTen ? currentUser.hoTen.charAt(0).toUpperCase() : 'U' %>
          </div>
          <div class="overflow-hidden">
            <div class="text-white small fw-bold text-truncate"><%= currentUser.hoTen %></div>
            <div class="user-role-badge"><%= currentUser.vaiTro %></div>
          </div>
        </div>
        <a href="/logout" class="btn btn-sm btn-outline-danger w-100 mt-1">
          <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
        </a>
      </div>
    <% } %>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="app-main">
    <!-- Navbar -->
    <header class="app-navbar">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light d-lg-none" type="button" onclick="document.querySelector('.app-sidebar').classList.toggle('show')">
          <i class="bi bi-list fs-5"></i>
        </button>
        <span class="text-muted small fw-medium">Hệ thống Quản lý Bán hàng theo từng IMEI/Serial</span>
      </div>

      <div class="d-flex align-items-center gap-3">
        <% if (currentUser) { %>
          <div class="text-end d-none d-sm-block">
            <div class="fw-semibold small"><%= currentUser.hoTen %></div>
            <div class="text-muted" style="font-size: 0.75rem;">@<%= currentUser.tenDangNhap %></div>
          </div>
        <% } %>
      </div>
    </header>

    <!-- Page Body -->
    <main class="page-container">
      <!-- Flash Messages -->
      <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
          <i class="bi bi-check-circle-fill me-2 fs-5"></i>
          <div><%= success_msg %></div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
          <div><%= error_msg %></div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <%- body %>
    </main>
  </div>
</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Custom JS -->
<script src="/js/main.js"></script>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
