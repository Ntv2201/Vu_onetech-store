<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .login-card {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.98);
      border-radius: 1rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
      padding: 2.5rem;
    }
    .brand-logo {
      width: 56px;
      height: 56px;
      background: #2563eb;
      color: #fff;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      margin: 0 auto 1.25rem;
    }
    .demo-account-badge {
      cursor: pointer;
      font-size: 0.78rem;
      padding: 0.35rem 0.6rem;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 0.5rem;
      transition: all 0.2s;
    }
    .demo-account-badge:hover {
      background: #e2e8f0;
      border-color: #94a3b8;
    }
  </style>
</head>
<body>

<div class="login-card">
  <div class="brand-logo">
    <i class="bi bi-phone-vibrate"></i>
  </div>
  <h4 class="text-center fw-bold mb-1">ONE TECH STORE</h4>
  <p class="text-center text-muted small mb-4">Hệ thống Quản lý Chuỗi Cửa hàng Điện thoại</p>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger py-2 small d-flex align-items-center mb-3">
      <i class="bi bi-exclamation-circle-fill me-2"></i>
      <div><%= error %></div>
    </div>
  <% } %>

  <form action="/login" method="POST">
    <div class="mb-3">
      <label class="form-label small fw-semibold">Tên đăng nhập</label>
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
        <input type="text" name="tenDangNhap" id="inputUsername" class="form-control" placeholder="admin / banhang / thukho..." required autofocus>
      </div>
    </div>

    <div class="mb-4">
      <label class="form-label small fw-semibold">Mật khẩu</label>
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
        <input type="password" name="matKhau" id="inputPassword" class="form-control" placeholder="Nhập mật khẩu" required>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
      <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập hệ thống
    </button>
  </form>

  <div class="border-top pt-3 mt-2">
    <div class="text-muted small fw-semibold mb-2">Tài khoản demo (click để điền nhanh):</div>
    <div class="d-flex flex-wrap gap-1">
      <span class="demo-account-badge" onclick="fillCreds('admin', 'admin123')">
        <strong>Quản lý:</strong> admin
      </span>
      <span class="demo-account-badge" onclick="fillCreds('banhang', '123456')">
        <strong>Bán hàng:</strong> banhang
      </span>
      <span class="demo-account-badge" onclick="fillCreds('thukho', '123456')">
        <strong>Thủ kho:</strong> thukho
      </span>
      <span class="demo-account-badge" onclick="fillCreds('thungan', '123456')">
        <strong>Thu ngân:</strong> thungan
      </span>
      <span class="demo-account-badge" onclick="fillCreds('ketoan', '123456')">
        <strong>Kế toán:</strong> ketoan
      </span>
      <span class="demo-account-badge" onclick="fillCreds('kythuat', '123456')">
        <strong>Kỹ thuật:</strong> kythuat
      </span>
    </div>
  </div>
</div>

<script>
function fillCreds(u, p) {
  document.getElementById('inputUsername').value = u;
  document.getElementById('inputPassword').value = p;
}
</script>

</body>
</html>
