<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Quản lý Phụ kiện</h4>
    <p class="text-muted small mb-0">Quản lý các sản phẩm phụ kiện (sạc, cáp, tai nghe, ốp lưng...) quản lý theo số lượng tồn</p>
  </div>
  <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPhuKienModal">
      <i class="bi bi-plus-lg me-1"></i> Thêm Phụ kiện
    </button>
  <% } %>
</div>

<!-- Filters Bar -->
<div class="card-custom p-3 mb-4">
  <form action="/phu-kien" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên phụ kiện..." value="<%= filters.search || '' %>">
      </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
      <select name="danhMucId" class="form-select">
        <option value="">-- Tất cả danh mục --</option>
        <% danhMucs.forEach(dm => { %>
          <option value="<%= dm._id %>" <%= filters.danhMucId == dm._id.toString() ? 'selected' : '' %>><%= dm.tenDanhMuc %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
      <a href="/phu-kien" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
    </div>
  </form>
</div>

<!-- Table of PhuKien -->
<div class="card-custom">
  <div class="table-responsive">
    <table class="table table-custom table-hover">
      <thead>
        <tr>
          <th>Tên phụ kiện</th>
          <th>Danh mục</th>
          <th>Giá bán</th>
          <th>Số lượng tồn kho</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (phuKiens && phuKiens.length > 0) { %>
          <% phuKiens.forEach(pk => { %>
            <tr>
              <td class="fw-bold text-dark"><%= pk.tenPK %></td>
              <td><span class="badge bg-light text-secondary border"><%= pk.danhMuc ? pk.danhMuc.tenDanhMuc : 'N/A' %></span></td>
              <td class="text-primary fw-semibold"><%= pk.giaBan ? pk.giaBan.toLocaleString('vi-VN') + ' đ' : '0 đ' %></td>
              <td>
                <span class="badge <%= pk.soLuongTon > 5 ? 'bg-success' : (pk.soLuongTon > 0 ? 'bg-warning text-dark' : 'bg-danger') %>">
                  <%= pk.soLuongTon %> cái
                </span>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPKModal<%= pk._id %>" title="Sửa">
                      <i class="bi bi-pencil"></i>
                    </button>
                  <% } %>
                  <% if (currentUser && currentUser.vaiTro === 'Quản lý') { %>
                    <form action="/phu-kien/<%= pk._id %>/xoa" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phụ kiện này?')">
                      <button type="submit" class="btn btn-outline-danger" title="Xóa">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>

                <!-- Edit Modal -->
                <div class="modal fade" id="editPKModal<%= pk._id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content text-start">
                      <form action="/phu-kien/<%= pk._id %>/chinh-sua" method="POST">
                        <div class="modal-header">
                          <h5 class="modal-title fw-bold">Chỉnh sửa Phụ kiện</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label">Tên phụ kiện <span class="text-danger">*</span></label>
                            <input type="text" name="tenPK" class="form-control" value="<%= pk.tenPK %>" required>
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                            <select name="danhMuc" class="form-select" required>
                              <% danhMucs.forEach(dm => { %>
                                <option value="<%= dm._id %>" <%= (pk.danhMuc && (pk.danhMuc._id || pk.danhMuc).toString() === dm._id.toString()) ? 'selected' : '' %>>
                                  <%= dm.tenDanhMuc %>
                                </option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="giaBan" class="form-control" value="<%= pk.giaBan %>" required min="0">
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Số lượng tồn kho</label>
                            <input type="number" name="soLuongTon" class="form-control" value="<%= pk.soLuongTon %>" min="0">
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                          <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy phụ kiện nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Thêm Phụ kiện -->
<div class="modal fade" id="addPhuKienModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/phu-kien/them-moi" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Thêm Phụ kiện Mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tên phụ kiện <span class="text-danger">*</span></label>
            <input type="text" name="tenPK" class="form-control" placeholder="VD: Sạc nhanh Apple 20W USB-C" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Danh mục <span class="text-danger">*</span></label>
            <select name="danhMuc" class="form-select" required>
              <option value="">-- Chọn danh mục --</option>
              <% danhMucs.forEach(dm => { %>
                <option value="<%= dm._id %>"><%= dm.tenDanhMuc %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
            <input type="number" name="giaBan" class="form-control" placeholder="VD: 550000" required min="0">
          </div>
          <div class="mb-3">
            <label class="form-label">Số lượng tồn ban đầu</label>
            <input type="number" name="soLuongTon" class="form-control" placeholder="10" value="0" min="0">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Thêm phụ kiện</button>
        </div>
      </form>
    </div>
  </div>
</div>
