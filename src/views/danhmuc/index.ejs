<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Quản lý Danh mục</h4>
    <p class="text-muted small mb-0">Phân loại sản phẩm (Điện thoại, iPad, Smartwatch, Phụ kiện, v.v.)</p>
  </div>
  <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDanhMucModal">
      <i class="bi bi-plus-lg me-1"></i> Thêm Danh mục
    </button>
  <% } %>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-8">
    <div class="card-custom">
      <div class="table-responsive">
        <table class="table table-custom table-hover">
          <thead>
            <tr>
              <th>Tên danh mục</th>
              <th>Số lượng model SP</th>
              <th>Số lượng phụ kiện</th>
              <th class="text-end">Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% if (danhMucs && danhMucs.length > 0) { %>
              <% danhMucs.forEach(dm => { %>
                <tr>
                  <td>
                    <span class="fw-bold text-dark fs-6"><%= dm.tenDanhMuc %></span>
                  </td>
                  <td>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                      <%= dm.countSP %> Model
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">
                      <%= dm.countPK %> Phụ kiện
                    </span>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <% if (currentUser && ['Quản lý', 'Thủ kho'].includes(currentUser.vaiTro)) { %>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal<%= dm._id %>" title="Sửa">
                          <i class="bi bi-pencil"></i>
                        </button>
                      <% } %>
                      <% if (currentUser && currentUser.vaiTro === 'Quản lý') { %>
                        <form action="/danh-muc/<%= dm._id %>/xoa" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?')">
                          <button type="submit" class="btn btn-outline-danger" title="Xóa" <%= (dm.countSP > 0 || dm.countPK > 0) ? 'disabled' : '' %>>
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal<%= dm._id %>" tabindex="-1">
                      <div class="modal-dialog">
                        <div class="modal-content text-start">
                          <form action="/danh-muc/<%= dm._id %>/chinh-sua" method="POST">
                            <div class="modal-header">
                              <h5 class="modal-title fw-bold">Chỉnh sửa Danh mục</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                              <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                              <input type="text" name="tenDanhMuc" class="form-control" value="<%= dm.tenDanhMuc %>" required>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                              <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-4 text-muted">Chưa có danh mục nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Thêm Danh mục -->
<div class="modal fade" id="addDanhMucModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/danh-muc/them-moi" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Thêm Danh mục Mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
          <input type="text" name="tenDanhMuc" class="form-control" placeholder="VD: Điện thoại, Máy tính bảng, Phụ kiện..." required autofocus>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Thêm danh mục</button>
        </div>
      </form>
    </div>
  </div>
</div>
