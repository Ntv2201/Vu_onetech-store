<div class="row justify-content-center">
  <div class="col-12 col-lg-7">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0"><%= isEdit ? 'Chỉnh sửa Nhân viên' : 'Thêm Nhân viên mới' %></h4>
      <a href="/nhan-vien" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
      </a>
    </div>

    <div class="card-custom p-4">
      <form action="<%= isEdit ? '/nhan-vien/' + nhanVien._id + '/chinh-sua' : '/nhan-vien/them-moi' %>" method="POST">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label">Họ và tên nhân viên <span class="text-danger">*</span></label>
            <input type="text" name="hoTen" class="form-control" placeholder="VD: Trần Văn B" value="<%= nhanVien.hoTen || '' %>" required>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Số điện thoại</label>
            <input type="text" name="sdt" class="form-control" placeholder="VD: 0912345678" value="<%= nhanVien.sdt || '' %>">
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
            <input type="text" name="tenDangNhap" class="form-control font-monospace" placeholder="VD: tranvanb" value="<%= nhanVien.tenDangNhap || '' %>" <%= isEdit ? 'readonly' : 'required' %>>
            <% if (isEdit) { %>
              <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
            <% } %>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Vai trò / Phân quyền <span class="text-danger">*</span></label>
            <select name="vaiTro" class="form-select" required>
              <% roles.forEach(r => { %>
                <option value="<%= r %>" <%= nhanVien.vaiTro === r ? 'selected' : '' %>><%= r %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label"><%= isEdit ? 'Mật khẩu mới (Để trống nếu không đổi)' : 'Mật khẩu' %> <span class="<%= isEdit ? '' : 'text-danger' %>">*</span></label>
            <input type="password" name="matKhau" class="form-control" placeholder="<%= isEdit ? 'Nhập mật khẩu mới...' : 'Mật khẩu đăng nhập' %>" <%= isEdit ? '' : 'required' %>>
          </div>

          <% if (isEdit) { %>
            <div class="col-12 col-md-6">
              <label class="form-label">Trạng thái tài khoản</label>
              <select name="trangThai" class="form-select">
                <option value="Hoạt động" <%= nhanVien.trangThai === 'Hoạt động' ? 'selected' : '' %>>Hoạt động</option>
                <option value="Khóa" <%= nhanVien.trangThai === 'Khóa' ? 'selected' : '' %>>Khóa tài khoản</option>
              </select>
            </div>
          <% } %>

          <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="/nhan-vien" class="btn btn-light">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2-circle me-1"></i> <%= isEdit ? 'Cập nhật' : 'Tạo tài khoản' %>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
