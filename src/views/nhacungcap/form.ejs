<div class="row justify-content-center">
  <div class="col-12 col-lg-6">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0"><%= isEdit ? 'Chỉnh sửa Nhà cung cấp' : 'Thêm Nhà cung cấp mới' %></h4>
      <a href="/nha-cung-cap" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
      </a>
    </div>

    <div class="card-custom p-4">
      <form action="<%= isEdit ? '/nha-cung-cap/' + nhaCungCap._id + '/chinh-sua' : '/nha-cung-cap/them-moi' %>" method="POST">
        <div class="mb-3">
          <label class="form-label">Tên nhà cung cấp / Công ty <span class="text-danger">*</span></label>
          <input type="text" name="tenNCC" class="form-control" placeholder="VD: FPT Synnex / Dầu khí..." value="<%= nhaCungCap.tenNCC || '' %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Số điện thoại liên hệ</label>
          <input type="text" name="sdt" class="form-control" placeholder="VD: 028 1234 5678" value="<%= nhaCungCap.sdt || '' %>">
        </div>

        <div class="mb-4">
          <label class="form-label">Địa chỉ trụ sở / Kho</label>
          <input type="text" name="diaChi" class="form-control" placeholder="VD: Quận 1, TP. Hồ Chí Minh" value="<%= nhaCungCap.diaChi || '' %>">
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
          <a href="/nha-cung-cap" class="btn btn-light">Hủy bỏ</a>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-1"></i> <%= isEdit ? 'Cập nhật' : 'Lưu Nhà cung cấp' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
